{% extends "layout.njk" %}

{% block title %}Verify email{% endblock %}

{% block content %}
  <section id="verify-page" class="card" data-api-base-url="{{ apiBaseUrl }}">
    <h1>Email verification</h1>

    <p id="verify-loading" role="status">Verifying your email...</p>

    <div id="verify-success" role="status" hidden>
      <p class="alert alert-success">Your email has been confirmed.</p>
      <p class="card-footer"><a href="/login">Go to login</a></p>
    </div>

    <div id="verify-error" hidden>
      <p class="alert" role="alert">This link is invalid or has expired.</p>
      <form id="resend-form" novalidate>
        <div class="form-field">
          <label for="resend-email">Email</label>
          <input id="resend-email" type="email" autocomplete="email">
        </div>
        <p id="resend-message" class="form-message" role="status"></p>
        <button type="submit" class="button">Send me a new email</button>
      </form>
    </div>
  </section>
{% endblock %}

{% block scripts %}
  <script src="/verify-email.js"></script>
{% endblock %}
