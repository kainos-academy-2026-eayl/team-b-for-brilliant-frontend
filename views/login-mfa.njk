{% extends "layout.njk" %}
{% block title %}Verify your identity{% endblock %}
{% block content %}
<section class="card">
  <h1>Verify your identity</h1>

  {% if error %}
    <p class="alert" role="alert">{{ error }}</p>
  {% endif %}

  {% if mfaUnavailable %}
    <p><a class="button" href="/login">Sign in manually</a></p>
  {% else %}
    <p class="card-subtitle">Enter the 6-digit code from your authenticator.</p>
    <form method="post" action="/login/mfa" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div class="form-field">
        <label for="code">Authentication code</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" required autofocus>
      </div>

      <button type="submit" class="button">Verify</button>
    </form>
    <p class="card-footer"><a href="/login">Back to sign in</a></p>
  {% endif %}
</section>
{% endblock %}
