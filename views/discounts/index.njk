{% extends "main.njk" %}

{% block title %}Discounts | B-Brilliant{% endblock %}

{% block head %}
  <style>
    {% include "discounts/discounts.css" %}
  </style>
{% endblock %}

{% block main_class %}discounts-main{% endblock %}

{% block content %}
  <div class="discounts__header">
    <h1>Discounts</h1>
    <a class="button discounts__add" href="/discounts/add">Add Discount</a>
  </div>

  {% if formError %}
    <p class="alert" role="alert">{{ formError }}</p>
  {% endif %}

  {% if discounts.length %}
    <table class="discounts__table">
      <thead>
        <tr>
          <th scope="col">Code</th>
          <th scope="col">Type</th>
          <th scope="col">Value</th>
          <th scope="col">Expires</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for discount in discounts %}
          {% set expiry = discount.expiryDate.slice(0, 10).split('-') %}
          <tr>
            <td>{{ discount.code }}</td>
            <td>{{ discount.type | replace('_', ' ') | capitalize }}</td>
            <td>{{ discount.value }}</td>
            <td>{{ expiry[2] }}/{{ expiry[1] }}/{{ expiry[0] }}</td>
            <td class="discounts__actions">
              {% if discount.isActive %}
                <form method="post" action="/discounts/{{ discount.discountID | urlencode }}/deactivate">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="button button-link" aria-label="Deactivate discount {{ discount.code }}">Deactivate</button>
                </form>
              {% else %}
                <a class="button-link" href="/discounts/{{ discount.discountID | urlencode }}/activate" aria-label="Activate discount {{ discount.code }}">Activate</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="empty-state">No discounts available.</p>
  {% endif %}
{% endblock %}
