<article class="product-detail">
  <div class="product-detail__images{% if product.productImages.length > 1 %} product-detail__images--gallery{% endif %}">
    {% if product.productImages.length > 1 or isProductPreview %}
      <div class="product-detail__thumbnails" role="group" aria-label="Product images"{% if product.productImages.length <= 1 %} hidden{% endif %}>
        {% for image in product.productImages %}
          <button
            type="button"
            class="product-detail__thumbnail"
            aria-label="View image {{ loop.index }} of {{ product.productImages.length }} for {{ product.name }}"
            aria-controls="product-main-image"
            aria-pressed="{{ 'true' if loop.first else 'false' }}"
            data-image-src="{{ image.imageUrl }}"
            data-image-alt="{{ product.name }} - image {{ loop.index }} of {{ product.productImages.length }}"
          >
            <img src="{{ image.imageUrl }}" alt="">
          </button>
        {% endfor %}
      </div>
    {% endif %}
    <div class="product__image{% if product.productImages.length %} product-detail__main-image{% endif %}">
      {% if product.productImages.length or isProductPreview %}
        <img id="product-main-image"{% if product.productImages.length %} src="{{ product.productImages[0].imageUrl }}"{% else %} hidden{% endif %} alt="{{ product.name }}{% if product.productImages.length > 1 %} - image 1 of {{ product.productImages.length }}{% endif %}">
      {% endif %}
      {% if not product.productImages.length or isProductPreview %}
        <span data-product-no-image{% if product.productImages.length %} hidden{% endif %}>No image available</span>
      {% endif %}
    </div>
  </div>
  <div class="product-detail__body">
    <h1{% if isProductPreview %} data-product-name tabindex="-1"{% endif %}>{{ product.name }}</h1>
    {% if (product.departments.length and not product.categories.length) or isProductPreview %}
      <dl class="product-detail__classification"{% if isProductPreview %} data-product-departments{% endif %}{% if not product.departments.length or product.categories.length %} hidden{% endif %}>
        <dt>Departments</dt>
        <dd>
          <ul>
            {% for department in product.departments %}
              <li>{{ department.name }}</li>
            {% endfor %}
          </ul>
        </dd>
      </dl>
    {% endif %}
    {% if product.quantity > 0 %}
      <span class="stock stock--in"{% if isProductPreview %} data-product-stock{% endif %}>In stock</span>
    {% else %}
      <span class="stock stock--out"{% if isProductPreview %} data-product-stock{% endif %}>Out of stock</span>
    {% endif %}
    {% if product.currentPrice %}
      <p class="product__price"{% if isProductPreview %} data-product-price{% endif %}>£{{ product.currentPrice }}</p>
    {% else %}
      <p class="product__price product__price--unavailable"{% if isProductPreview %} data-product-price{% endif %}>Price unavailable</p>
    {% endif %}
    {% if isProductPreview %}
      <div class="product-detail__basket">
    {% else %}
      <form method="post" action="/basket/items" class="product-detail__basket">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="productID" value="{{ product.productID }}">
    {% endif %}
      <div class="form-field">
        <label for="product-quantity">Quantity</label>
        <select id="product-quantity" name="quantity"{% if product.quantity <= 0 %} disabled{% endif %}>
          {% if product.quantity > 0 %}
            {% set maxQuantity = 10 if product.quantity > 10 else product.quantity %}
            {% for quantity in range(1, maxQuantity + 1) %}
              <option value="{{ quantity }}">{{ quantity }}</option>
            {% endfor %}
          {% else %}
            <option value="0">0</option>
          {% endif %}
        </select>
      </div>
      <button type="{{ 'button' if isProductPreview else 'submit' }}" class="button"{% if product.quantity <= 0 %} disabled{% endif %}>Add to basket</button>
    {% if isProductPreview %}
      </div>
    {% else %}
      </form>
    {% endif %}
    {% if product.description or isProductPreview %}
      <h2{% if isProductPreview %} data-product-description-heading{% endif %}{% if not product.description %} hidden{% endif %}>Description</h2>
      <p class="product-detail__description"{% if not product.description %} hidden{% endif %}>{{ product.description }}</p>
    {% endif %}
    {% if product.categories.length or isProductPreview %}
      <h2{% if isProductPreview %} data-product-categories-heading{% endif %}{% if not product.categories.length %} hidden{% endif %}>Categories</h2>
      <dl class="product-detail__classification"{% if isProductPreview %} data-product-categories{% endif %}{% if not product.categories.length %} hidden{% endif %}>
        {% for departmentID, categories in product.categories | groupby('departmentID') %}
          {% set departmentName = 'Other categories' %}
          {% for department in product.departments %}
            {% if department.departmentID == departmentID %}
              {% set departmentName = department.name %}
            {% endif %}
          {% endfor %}
          <dt>{{ departmentName }}</dt>
          <dd>
            <ul>
              {% for category in categories %}
                <li>{{ category.name }}</li>
              {% endfor %}
            </ul>
          </dd>
        {% endfor %}
      </dl>
    {% endif %}
  </div>
</article>
