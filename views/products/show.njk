{% extends "main.njk" %}
{% from "products/detail.njk" import renderProductDetail %}

{% block title %}{{ product.name }} | B-Brilliant{% endblock %}

{% block head %}
  <style>
    {% include "products/products.css" %}
  </style>
{% endblock %}

{% block main_class %}product-customer-main{% endblock %}

{% block content %}
  {{ renderProductDetail(product, false, csrfToken) }}
{% endblock %}

{% block scripts %}
  {% if product.productImages.length > 1 %}
    <script src="/static/product-gallery.js" defer></script>
  {% endif %}
{% endblock %}
