{% extends "main.njk" %}

{% block title %}{{ product.name }} | B-Brilliant{% endblock %}

{% block head %}
  <style>
    {% include "products/products.css" %}
  </style>
{% endblock %}

{% block content %}
  <a class="products-back" href="/products">Back to products</a>
  {% if isAdmin %}
    {% if product.draft or not product.visible %}
      <p class="product__draft">Draft - visible only to admins</p>
    {% endif %}
    <p><a href="/products/{{ product.productID | urlencode }}/edit">Edit product</a></p>
  {% endif %}
  {% include "products/detail.njk" %}
{% endblock %}

{% block scripts %}
  {% if product.productImages.length > 1 %}
    <script src="/static/product-gallery.js" defer></script>
  {% endif %}
{% endblock %}
