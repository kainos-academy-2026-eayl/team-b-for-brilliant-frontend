<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Discover everyday essentials at B-Brilliant.">
    <title>B-Brilliant | Everyday, made brilliant</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <script type="module" src="/assets/js/home.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">A little inspiration for your everyday.</div>
    <header class="site-header">
      <div class="shell header-inner">
        <div>
          <a class="brand" href="/" aria-label="B-Brilliant home">B-Brilliant<span aria-hidden="true">*</span></a>
          <p class="brand-slogan">Never Settle for less</p>
        </div>
        <nav aria-label="Main navigation"><a class="nav-link" href="#products">Explore the collection <span aria-hidden="true">&rarr;</span></a></nav>
      </div>
    </header>
    <main class="shell" id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <p class="eyebrow"><span class="little-star" aria-hidden="true">*</span> SMALL THINGS. BRILLIANT POSSIBILITIES.</p>
          <h1 id="hero-title">Your everyday.<br>A little more <em>brilliant.</em></h1>
          <p class="hero-description">Discover thoughtful essentials for your home, your desk, and everywhere life takes you.</p>
          <a class="button button-dark" href="#products">Browse the collection <span aria-hidden="true">&rarr;</span></a>
          <p class="hero-caption">Good finds. Fresh inspiration. All in one place.</p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-circle"></div>
          <span class="art-label">THE EVERYDAY EDIT<br>BY B-BRILLIANT</span>
          <img class="hero-bag" src="/assets/images/tote.svg" alt="" width="400" height="330">
          <div class="art-sticker">Less ordinary.<br><em>More you.</em><span>*</span></div>
          <span class="art-bottom">MADE FOR THE LITTLE MOMENTS</span>
        </div>
      </section>
      <section class="collection" id="products" aria-labelledby="collection-title">
        <div class="collection-heading">
          <div><p class="eyebrow">FIND YOUR NEXT FAVOURITE</p><h2 id="collection-title">The everyday collection<span class="heading-dot">.</span></h2></div>
          <p class="collection-description">A few good things to get you started.</p>
        </div>
        <div class="collection-meta">
          <span class="collection-tag">All products</span>
          <p id="product-count" role="status"></p>
        </div>
        <p class="sample-banner">Demo catalogue &mdash; sample products and prices for preview only. No purchases are available.</p>
        <noscript><p class="message-state">Please enable JavaScript to view this demo catalogue.</p></noscript>
        <div id="catalogue-results" aria-busy="true">
          <div id="loading-state" class="loading-state" role="status" hidden><span class="spinner" aria-hidden="true"></span><p>Loading products&hellip;</p></div>
          <div id="empty-state" class="message-state" role="status" hidden><span class="state-symbol" aria-hidden="true">*</span><h3>No products available</h3><p>Please check back soon for something brilliant.</p></div>
          <div id="error-state" class="message-state" role="alert" hidden><h3>We couldn&rsquo;t load the products</h3><p>Please try again in a moment.</p><button class="button button-dark" id="retry-products" type="button">Try again</button></div>
          <ul class="product-grid" id="product-grid" aria-label="Products"></ul>
        </div>
      </section>
      <aside class="closing-note"><span aria-hidden="true">*</span><p>Everyday essentials.<br>Extraordinary little moments.</p><p>That's the B-Brilliant way.</p></aside>
    </main>
    <footer class="site-footer"><div class="shell footer-inner"><a class="brand" href="/">B-Brilliant<span aria-hidden="true">*</span></a><p>Never Settle for less</p><p class="demo-note">A demo storefront. A world of possibilities.</p></div></footer>
    <template id="product-template">
      <li class="product-card">
        <article>
          <div class="product-visual"><img alt="" width="360" height="320" loading="lazy"><span class="stock-label"></span></div>
          <div class="product-detail"><p class="product-category"></p><h3 class="product-name"></h3><p class="product-price"></p></div>
        </article>
      </li>
    </template>
  </body>
</html>
