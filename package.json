{
  "name": "technologist-academy-node-service-template",
  "version": "1.0.0",
  "description": "A template repository for node services developed in the Technologist Academy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "postinstall": "prisma generate",
    "typecheck": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "26.4.1",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "prisma": "^7.10.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nunjucks": "^3.1.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}